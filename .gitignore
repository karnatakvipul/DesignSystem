# Dependencies — restore with `npm install`.
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# Build output. `npm run build` regenerates dist/, and package.json's `main`,
# `module` and `exports` all point into it. Consumers that alias the package to
# src/ (as the SLS app does) never read it, but anyone importing the package
# normally must build first.
dist/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Packed tarballs from `npm pack`.
*.tgz

# Test and tooling output.
coverage/
.vite/
*.local

# Editor and OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment overrides.
.env
.env.local
.env.*.local

# Generated into the docs site by scripts/collect-docs.mjs — edit the root files.
docs/design-system.md
docs/building-an-app.md
docs/contributing.md
docs/changelog.md
docs/components.md

*storybook.log
storybook-static
